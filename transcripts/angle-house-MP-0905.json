    {
      "index": 6,
      "start": 21.9,
      "end": 23.22,
      "timestamp": "0:21",
      "range": "0:21 - 0:23",
      "text": "I forgot to tell you we did that."
    },
    {
      "index": 7,
      "start": 23.76,
      "end": 27.92,
      "timestamp": "0:23",
      "range": "0:23 - 0:27",
      "text": "But this is a heated floor, and this is the thermostat, and it's programmable, so you can"
