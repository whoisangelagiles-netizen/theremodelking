    {
      "index": 23,
      "start": 65.52,
      "end": 67.22,
      "timestamp": "1:05",
      "range": "1:05 - 1:07",
      "text": "And so this is a great solution."
    },
    {
      "index": 24,
      "start": 68.12,
      "end": 69.34,
      "timestamp": "1:08",
      "range": "1:08 - 1:09",
      "text": "Got that off Amazon."
    },
    {
      "index": 25,
      "start": 70.36,
      "end": 70.78,
      "timestamp": "1:10",
      "range": "1:10 - 1:10",
      "text": "Isn't that cool?"
    },
    {
      "index": 26,
